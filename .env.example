# ============================================================
# NEMITH — Environment Variables
# ============================================================
# Copy this to .env.local and fill in your values.
# NEVER commit .env or .env.local to version control.

# --- LLM Provider (Required) ---
# Get your key at https://openrouter.ai/keys
# Works with 200+ models: GPT-4o, Claude, Llama, Gemini, etc.
OPENROUTER_API_KEY=your_openrouter_key_here

# Default model to use (via OpenRouter)
# Full list: https://openrouter.ai/models
OPENROUTER_MODEL=minimax/minimax-m3:free

# Your app name (shows in OpenRouter rankings)
NEXT_PUBLIC_APP_NAME=Nemith

# --- Web Search (Required for research mode) ---
# Get yours at https://serper.dev/ (free tier: 2500 searches/mo)
SERPER_API_KEY=your_serper_key_here

# --- GitHub Integration (Optional) ---
# Create a PAT at https://github.com/settings/tokens
# Required scope: repo (read-only)
GITHUB_TOKEN=your_github_token_here

# --- App Config ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
