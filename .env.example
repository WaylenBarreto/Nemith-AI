# ============================================================
# NEMITH — Environment Variables
# ============================================================
# Copy this to .env.local and fill in your values.
# NEVER commit .env or .env.local to version control.

# --- Gemini (Cloud LLM) ---
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Ollama (Local LLM, no key needed) ---
# Install: https://ollama.com/download
# Pull a model: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:latest

# --- Load Balancing ---
# Requests are split 50/50 between Gemini and Ollama.
# If one fails, requests auto-fallback to the other.

# --- Web Search ---
SERPER_API_KEY=your_serper_key_here

# --- GitHub Integration (Optional, read-only) ---
GITHUB_TOKEN=your_github_token_here

# --- Supabase Database (Required for persistence) ---
# Create a project at https://supabase.com
# Go to Settings → API to find these values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- App Config ---
NEXT_PUBLIC_APP_NAME=Nemith
NEXT_PUBLIC_APP_URL=http://localhost:3000
